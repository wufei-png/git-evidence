{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://git-evidence.dev/schemas/evidence-bundle-0.2.schema.json",
  "title": "Git Evidence canonical bundle 0.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "canonicalization", "plan_id", "plan", "invocation",
    "bundle_digest", "providers", "repositories", "actors", "work_items",
    "change_requests", "interactions", "commits", "ref_changes", "releases",
    "retrievals", "evidence", "assertions", "collection", "privacy", "coverage"
  ],
  "properties": {
    "schema_version": {"const": "0.2"},
    "canonicalization": {"$ref": "#/$defs/canonicalization"},
    "plan_id": {"type": "string", "pattern": "^plan:sha256:[0-9a-f]{64}$"},
    "plan": {"$ref": "#/$defs/plan"},
    "invocation": {"$ref": "#/$defs/invocation"},
    "bundle_digest": {"type": "string", "pattern": "^bundle:sha256:[0-9a-f]{64}$"},
    "providers": {"type": "array", "items": {"$ref": "#/$defs/provider"}},
    "repositories": {"type": "array", "items": {"$ref": "#/$defs/repository"}},
    "actors": {"type": "array", "items": {"$ref": "#/$defs/actor"}},
    "work_items": {"type": "array", "items": {"$ref": "#/$defs/work_item"}},
    "change_requests": {"type": "array", "items": {"$ref": "#/$defs/change_request"}},
    "interactions": {"type": "array", "items": {"$ref": "#/$defs/interaction"}},
    "commits": {"type": "array", "items": {"$ref": "#/$defs/commit"}},
    "ref_changes": {"type": "array", "items": {"$ref": "#/$defs/ref_change"}},
    "releases": {"type": "array", "items": {"$ref": "#/$defs/release"}},
    "retrievals": {"type": "array", "items": {"$ref": "#/$defs/retrieval"}},
    "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
    "assertions": {"type": "array", "items": {"$ref": "#/$defs/assertion"}},
    "collection": {"$ref": "#/$defs/collection"},
    "privacy": {"$ref": "#/$defs/privacy"},
    "coverage": {"$ref": "#/$defs/coverage"},
    "migration": {"$ref": "#/$defs/migration"},
    "extensions": {"$ref": "#/$defs/extensions"}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1},
    "timestamp": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "nullable_timestamp": {"type": ["string", "null"], "format": "date-time", "pattern": "Z$"},
    "extensions": {
      "type": "object",
      "propertyNames": {"pattern": "^[a-z][a-z0-9_-]*$"},
      "additionalProperties": {"type": "object"}
    },
    "canonicalization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "version", "unicode_normalization"],
      "properties": {
        "algorithm": {"const": "RFC8785"},
        "version": {"const": "v1"},
        "unicode_normalization": {"const": "NFC"}
      }
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end", "timezone"],
      "properties": {
        "start": {"$ref": "#/$defs/timestamp"},
        "end": {"$ref": "#/$defs/timestamp"},
        "timezone": {"type": "string", "minLength": 1}
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repositories", "actors"],
      "properties": {
        "repositories": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "actors": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
      }
    },
    "source_name": {
      "enum": ["repositories", "work_items", "change_requests", "interactions", "commits", "releases", "activities", "ref_changes"]
    },
    "plan_provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "instance", "selected_sources"],
      "properties": {
        "kind": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
        "instance": {"$ref": "#/$defs/id"},
        "selected_sources": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/source_name"}},
        "options": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "include_activity_api", "verify_tls", "allow_insecure_loopback",
            "timeout_seconds", "max_retries", "max_pages", "max_requests",
            "retry_backoff_seconds", "retry_jitter_seconds",
            "retry_after_max_seconds", "cache_enabled", "cache_ttl_seconds",
            "cache_max_entries"
          ],
          "properties": {
            "include_activity_api": {"type": "boolean"},
            "verify_tls": {"type": "boolean"},
            "allow_insecure_loopback": {"type": "boolean"},
            "timeout_seconds": {"type": "number"},
            "max_retries": {"type": "integer"},
            "max_pages": {"type": "integer"},
            "max_requests": {"type": "integer"},
            "retry_backoff_seconds": {"type": "number"},
            "retry_jitter_seconds": {"type": "number"},
            "retry_after_max_seconds": {"type": "number"},
            "cache_enabled": {"type": "boolean"},
            "cache_ttl_seconds": {"type": "number"},
            "cache_max_entries": {"type": "integer"}
          }
        },
        "extensions": {"$ref": "#/$defs/extensions"}
      }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin", "window", "scope", "providers"],
      "properties": {
        "origin": {"enum": ["collection", "legacy_migration"]},
        "window": {"$ref": "#/$defs/window"},
        "scope": {"$ref": "#/$defs/scope"},
        "providers": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/plan_provider"}}
      },
      "allOf": [
        {
          "if": {"properties": {"origin": {"const": "collection"}}},
          "then": {
            "properties": {
              "providers": {"items": {"required": ["options"]}}
            }
          }
        }
      ]
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"const": "git-evidence"},
        "version": {"type": "string", "minLength": 1},
        "commit": {"type": "string", "minLength": 1}
      }
    },
    "invocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "started_at", "finished_at", "generator"],
      "properties": {
        "id": {"type": "string", "pattern": "^invocation:[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
        "started_at": {"$ref": "#/$defs/timestamp"},
        "finished_at": {"$ref": "#/$defs/timestamp"},
        "generator": {"$ref": "#/$defs/generator"}
      }
    },
    "capabilities": {
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/source_name"},
      "additionalProperties": {"enum": ["supported", "unsupported", "unavailable", "incomplete"]}
    },
    "provider": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "instance", "capabilities"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "kind": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
        "instance": {"$ref": "#/$defs/id"}, "capabilities": {"$ref": "#/$defs/capabilities"},
        "extensions": {"$ref": "#/$defs/extensions"}
      }
    },
    "repository": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "provider_id", "full_name", "web_url"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "provider_id": {"$ref": "#/$defs/id"},
        "full_name": {"$ref": "#/$defs/id"}, "name": {"$ref": "#/$defs/id"},
        "web_url": {"type": "string", "format": "uri"}, "extensions": {"$ref": "#/$defs/extensions"}
      }
    },
    "actor": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "provider_id", "source_id"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "provider_id": {"$ref": "#/$defs/id"},
        "source_id": {"$ref": "#/$defs/id"}, "handle": {"type": ["string", "null"]},
        "extensions": {"$ref": "#/$defs/extensions"}
      }
    },
    "activity_base": {
      "type": "object",
      "required": ["id", "repository_id"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "repository_id": {"$ref": "#/$defs/id"},
        "actor_id": {"$ref": "#/$defs/id"}, "occurred_at": {"$ref": "#/$defs/nullable_timestamp"},
        "kind": {"$ref": "#/$defs/id"}, "web_url": {"type": ["string", "null"], "format": "uri"},
        "extensions": {"$ref": "#/$defs/extensions"}
      }
    },
    "work_item": {
      "allOf": [{"$ref": "#/$defs/activity_base"}],
      "type": "object", "additionalProperties": false,
      "required": ["id", "repository_id", "kind", "number", "title"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "repository_id": {"$ref": "#/$defs/id"}, "actor_id": {"$ref": "#/$defs/id"},
        "occurred_at": {"$ref": "#/$defs/nullable_timestamp"}, "kind": {"$ref": "#/$defs/id"},
        "number": {"type": ["integer", "string"]}, "title": {"type": "string"}, "state": {"type": ["string", "null"]},
        "web_url": {"type": ["string", "null"], "format": "uri"}, "extensions": {"$ref": "#/$defs/extensions"}
      }
    },
    "change_request": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "repository_id", "kind", "number", "title"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "repository_id": {"$ref": "#/$defs/id"}, "actor_id": {"$ref": "#/$defs/id"},
        "occurred_at": {"$ref": "#/$defs/nullable_timestamp"}, "kind": {"$ref": "#/$defs/id"},
        "number": {"type": ["integer", "string"]}, "title": {"type": "string"}, "state": {"type": ["string", "null"]},
        "merged_at": {"$ref": "#/$defs/nullable_timestamp"}, "web_url": {"type": ["string", "null"], "format": "uri"},
        "extensions": {"$ref": "#/$defs/extensions"}
      }
    },
    "interaction": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "repository_id", "kind", "subject_type", "subject_id", "body_collected"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "repository_id": {"$ref": "#/$defs/id"}, "actor_id": {"$ref": "#/$defs/id"},
        "occurred_at": {"$ref": "#/$defs/nullable_timestamp"}, "kind": {"$ref": "#/$defs/id"},
        "subject_type": {"enum": ["work_item", "change_request"]}, "subject_id": {"$ref": "#/$defs/id"},
        "subject_number": {"type": ["integer", "string"]}, "body_collected": {"type": "boolean"},
        "web_url": {"type": ["string", "null"], "format": "uri"}, "extensions": {"$ref": "#/$defs/extensions"}
      }
    },
    "commit": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "repository_id", "sha", "hash_algorithm"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "repository_id": {"$ref": "#/$defs/id"}, "actor_id": {"$ref": "#/$defs/id"},
        "occurred_at": {"$ref": "#/$defs/nullable_timestamp"}, "title": {"type": "string"},
        "sha": {"type": "string", "pattern": "^(?:[0-9A-Fa-f]{40}|[0-9A-Fa-f]{64})$"},
        "hash_algorithm": {"enum": ["sha1", "sha256"]}, "web_url": {"type": ["string", "null"], "format": "uri"},
        "extensions": {"$ref": "#/$defs/extensions"}
      }
    },
    "ref_change": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "repository_id", "change_association"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "repository_id": {"$ref": "#/$defs/id"}, "actor_id": {"$ref": "#/$defs/id"},
        "occurred_at": {"$ref": "#/$defs/nullable_timestamp"}, "kind": {"$ref": "#/$defs/id"}, "ref": {"type": ["string", "null"]},
        "change_association": {"enum": ["linked", "unlinked", "ambiguous", "unknown"]},
        "commit_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "commit_shas": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "change_request_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "evidence_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "web_url": {"type": ["string", "null"], "format": "uri"}, "extensions": {"$ref": "#/$defs/extensions"}
      }
    },
    "release": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "repository_id"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "repository_id": {"$ref": "#/$defs/id"}, "actor_id": {"$ref": "#/$defs/id"},
        "occurred_at": {"$ref": "#/$defs/nullable_timestamp"}, "name": {"type": ["string", "null"]}, "tag": {"type": ["string", "null"]},
        "web_url": {"type": ["string", "null"], "format": "uri"}, "extensions": {"$ref": "#/$defs/extensions"}
      }
    },
    "retrieval": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "provider_id", "mode", "endpoint_kind", "target_ref"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "provider_id": {"$ref": "#/$defs/id"},
        "mode": {"enum": ["live", "cache_replay", "legacy_import"]}, "endpoint_kind": {"$ref": "#/$defs/id"},
        "target_ref": {"$ref": "#/$defs/id"}, "repository_id": {"$ref": "#/$defs/id"}, "fetched_at": {"$ref": "#/$defs/timestamp"},
        "replayed_at": {"$ref": "#/$defs/timestamp"}, "stored_at": {"$ref": "#/$defs/timestamp"},
        "cache_age_seconds": {"type": "number", "minimum": 0}, "cache_ttl_seconds": {"type": "number", "minimum": 0},
        "page": {"type": "integer", "minimum": 1}, "pagination_outcome": {"$ref": "#/$defs/pagination_outcome"},
        "etag": {"type": "string"}, "last_modified": {"type": "string"}, "api_version": {"type": "string"},
        "source_artifact_digest": {"type": "string", "pattern": "^artifact:sha256:[0-9a-f]{64}$"},
        "payload_digest": {"type": "string", "pattern": "^payload:sha256:[0-9a-f]{64}$"},
        "extensions": {"$ref": "#/$defs/extensions"}
      },
      "allOf": [
        {"if": {"properties": {"mode": {"const": "live"}}}, "then": {"required": ["repository_id", "fetched_at"]}},
        {"if": {"properties": {"mode": {"const": "cache_replay"}}}, "then": {"required": ["repository_id", "fetched_at", "stored_at", "replayed_at", "cache_age_seconds", "cache_ttl_seconds"]}},
        {"if": {"properties": {"mode": {"const": "legacy_import"}}}, "then": {"required": ["source_artifact_digest"]}}
      ]
    },
    "native_identity": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["state", "value"],
          "properties": {"state": {"const": "known"}, "value": {"$ref": "#/$defs/id"}}
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["state", "reason"],
          "properties": {"state": {"const": "unavailable"}, "reason": {"const": "not_recorded_in_schema_0.1"}}
        }
      ]
    },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "provider_id", "retrieval_id", "native_identity", "subject_type", "subject_id", "source"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "provider_id": {"$ref": "#/$defs/id"}, "retrieval_id": {"$ref": "#/$defs/id"},
        "native_identity": {"$ref": "#/$defs/native_identity"}, "subject_type": {"$ref": "#/$defs/id"}, "subject_id": {"$ref": "#/$defs/id"},
        "source": {"$ref": "#/$defs/id"}, "url": {"type": "string", "format": "uri"}, "source_ref": {"$ref": "#/$defs/id"},
        "extensions": {"$ref": "#/$defs/extensions"}
      },
      "anyOf": [{"required": ["url"]}, {"required": ["source_ref"]}]
    },
    "predicate": {
      "enum": [
        "work_item.observed.v1", "change_request.observed.v1", "change_request.merged.v1",
        "interaction.observed.v1", "commit.observed.v1", "ref_change.observed.v1",
        "release.observed.v1", "release.published.v1"
      ]
    },
    "assertion": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "subject_type", "subject_id", "predicate", "occurred_at", "repository_id", "evidence_ids"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "subject_type": {"$ref": "#/$defs/id"}, "subject_id": {"$ref": "#/$defs/id"},
        "predicate": {"$ref": "#/$defs/predicate"}, "occurred_at": {"$ref": "#/$defs/timestamp"},
        "repository_id": {"$ref": "#/$defs/id"}, "actor_id": {"$ref": "#/$defs/id"},
        "evidence_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "extensions": {"$ref": "#/$defs/extensions"}
      }
    },
    "failure_class": {
      "enum": ["permission_denied", "rate_limited", "service_error", "not_found", "request_rejected", "malformed_response", "network_error", "transport_error", "fixture_missing", "http_error", "provider_not_ready", "unexpected_error", "unexpected_normalizer_error", "budget_exhausted", "insecure_transport", "limit_exceeded", "privacy_violation"]
    },
    "pagination_outcome": {"enum": ["cursor_exhausted", "link_exhausted", "documented_short_page", "date_boundary_reached", "max_pages_reached", "cycle_detected"]},
    "metrics": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "request_count": {"type": "integer", "minimum": 0}, "page_count": {"type": "integer", "minimum": 0},
        "retry_count": {"type": "integer", "minimum": 0}, "budget_exhausted": {"type": "boolean"},
        "cache_hits": {"type": "integer", "minimum": 0}, "cache_misses": {"type": "integer", "minimum": 0},
        "cache_enabled": {"type": "boolean"}, "insecure_transport": {"type": "boolean"}
      }
    },
    "commit_association_diagnostics": {
      "type": "object", "additionalProperties": false,
      "required": ["summary"],
      "properties": {
        "summary": {
          "type": "object", "additionalProperties": false,
          "required": ["attempted", "complete", "failed"],
          "properties": {
            "attempted": {"type": "integer", "minimum": 0},
            "complete": {"type": "integer", "minimum": 0},
            "failed": {"type": "integer", "minimum": 0}
          }
        },
        "failure_classes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/failure_class"}}
      }
    },
    "coverage_diagnostics": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "failure_class": {"$ref": "#/$defs/failure_class"},
        "failure_classes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/failure_class"}},
        "status_code": {"type": "integer"}, "attempts": {"type": "integer", "minimum": 1}, "retryable": {"type": "boolean"},
        "retry_after_seconds": {"type": "number", "minimum": 0}, "group_failure": {"type": "boolean"},
        "dropped_count": {"type": "integer", "minimum": 0}, "malformed_items": {"type": "integer", "minimum": 0},
        "duplicate_count": {"type": "integer", "minimum": 0}, "exception_type": {"type": "string"},
        "diagnostics_type": {"type": "string"}, "note_type": {"type": "string"}, "reason": {"type": "string"},
        "pagination": {
          "type": "object", "additionalProperties": false, "required": ["outcome", "complete"],
          "properties": {"outcome": {"$ref": "#/$defs/pagination_outcome"}, "complete": {"type": "boolean"}}
        },
        "rate_limit": {
          "type": "object", "additionalProperties": false,
          "properties": {"x-ratelimit-limit": {"type": "string"}, "x-ratelimit-remaining": {"type": "string"}, "x-ratelimit-reset": {"type": "string"}, "retry-after": {"type": "string"}}
        },
        "metrics": {"$ref": "#/$defs/metrics"}, "dependency": {"$ref": "#/$defs/coverage_diagnostics"},
        "child_diagnostics": {"type": "array", "items": {"$ref": "#/$defs/coverage_diagnostics"}},
        "commit_association": {"$ref": "#/$defs/commit_association_diagnostics"},
        "extensions": {"$ref": "#/$defs/extensions"}
      }
    },
    "collection_limits": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "timeout_seconds": {"type": "number"}, "max_retries": {"type": "integer"}, "max_pages": {"type": "integer"},
        "max_requests": {"type": "integer"}, "retry_jitter_seconds": {"type": "number"}, "retry_after_max_seconds": {"type": "number"}
      }
    },
    "collection_group": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "provider": {"type": "string"}, "instance": {"type": "string"},
        "group_status": {"enum": ["completed", "failed", "diagnostic_insecure_transport"]},
        "failure_class": {"$ref": "#/$defs/failure_class"}, "limits": {"$ref": "#/$defs/collection_limits"},
        "metrics": {"$ref": "#/$defs/metrics"}, "extensions": {"$ref": "#/$defs/extensions"}
      }
    },
    "collection": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "provider": {"type": "string"}, "instance": {"type": "string"},
        "group_status": {"enum": ["completed", "failed", "diagnostic_insecure_transport"]},
        "failure_class": {"$ref": "#/$defs/failure_class"}, "limits": {"$ref": "#/$defs/collection_limits"},
        "metrics": {"$ref": "#/$defs/metrics"}, "groups": {"type": "array", "items": {"$ref": "#/$defs/collection_group"}},
        "extensions": {"$ref": "#/$defs/extensions"}
      }
    },
    "privacy": {
      "type": "object", "additionalProperties": false,
      "required": ["actor_display", "source_urls", "auth_redaction"],
      "properties": {"actor_display": {"const": "anonymous"}, "source_urls": {"const": "sanitized"}, "auth_redaction": {"const": true}}
    },
    "coverage_observation": {
      "type": "object", "additionalProperties": false,
      "required": ["source", "provider_id", "repository_id", "status"],
      "properties": {
        "source": {"$ref": "#/$defs/source_name"}, "provider_id": {"$ref": "#/$defs/id"}, "repository_id": {"$ref": "#/$defs/id"},
        "status": {"enum": ["supported", "unsupported", "unavailable", "incomplete"]}, "note": {"type": "string"},
        "diagnostics": {"$ref": "#/$defs/coverage_diagnostics"}, "extensions": {"$ref": "#/$defs/extensions"}
      }
    },
    "coverage_blocker": {
      "type": "object", "additionalProperties": false,
      "required": ["code", "provider", "instance", "repository", "source", "status"],
      "properties": {
        "code": {"enum": ["aggregate_record_failure", "duplicate_records", "privacy_violation", "required_source_failure", "required_source_incomplete"]},
        "provider": {"type": "string"}, "instance": {"type": "string"}, "repository": {"$ref": "#/$defs/id"},
        "source": {"$ref": "#/$defs/source_name"}, "status": {"enum": ["unsupported", "unavailable", "incomplete"]},
        "failure_class": {"$ref": "#/$defs/failure_class"}, "message": {"type": "string"}, "observation_id": {"$ref": "#/$defs/id"}
      }
    },
    "coverage_warning": {
      "type": "object", "additionalProperties": false,
      "required": ["code", "source", "provider_id", "repository_id", "status"],
      "properties": {
        "code": {"const": "optional_coverage_warning"}, "source": {"enum": ["activities", "ref_changes"]},
        "provider_id": {"$ref": "#/$defs/id"}, "repository_id": {"$ref": "#/$defs/id"},
        "status": {"enum": ["unsupported", "unavailable", "incomplete"]}, "message": {"type": "string"},
        "failure_class": {"$ref": "#/$defs/failure_class"},
        "failure_classes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/failure_class"}}
      }
    },
    "group_failure": {
      "type": "object", "additionalProperties": false,
      "required": ["provider", "instance", "repository", "source", "failure_class"],
      "properties": {
        "provider": {"type": "string"}, "instance": {"type": "string"}, "repository": {"$ref": "#/$defs/id"},
        "source": {"$ref": "#/$defs/source_name"}, "failure_class": {"$ref": "#/$defs/failure_class"}, "reason": {"type": "string"}
      }
    },
    "coverage": {
      "type": "object", "additionalProperties": false,
      "required": ["required_sources", "observations", "fatal", "warnings", "group_failures", "render_eligible"],
      "properties": {
        "required_sources": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/source_name"}},
        "observations": {"type": "array", "items": {"$ref": "#/$defs/coverage_observation"}},
        "fatal": {"type": "array", "items": {"$ref": "#/$defs/coverage_blocker"}},
        "warnings": {"type": "array", "items": {"$ref": "#/$defs/coverage_warning"}},
        "group_failures": {"type": "array", "items": {"$ref": "#/$defs/group_failure"}},
        "render_eligible": {"type": "boolean"}, "extensions": {"$ref": "#/$defs/extensions"}
      }
    },
    "migration": {
      "type": "object", "additionalProperties": false,
      "required": ["source_schema_version", "source_artifact_digest", "migrated_at"],
      "properties": {
        "source_schema_version": {"const": "0.1"},
        "source_artifact_digest": {"type": "string", "pattern": "^artifact:sha256:[0-9a-f]{64}$"},
        "migrated_at": {"$ref": "#/$defs/timestamp"}
      }
    }
  }
}
