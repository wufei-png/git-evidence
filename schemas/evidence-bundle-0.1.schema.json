{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Git Evidence canonical bundle",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "run",
    "providers",
    "repositories",
    "actors",
    "work_items",
    "change_requests",
    "interactions",
    "commits",
    "ref_changes",
    "releases",
    "evidence",
    "facts",
    "coverage"
  ],
  "properties": {
    "schema_version": {"const": "0.1"},
    "run": {"$ref": "#/$defs/run"},
    "providers": {"type": "array", "items": {"$ref": "#/$defs/entity"}},
    "repositories": {"type": "array", "items": {"$ref": "#/$defs/entity"}},
    "actors": {"type": "array", "items": {"$ref": "#/$defs/entity"}},
    "work_items": {"type": "array", "items": {"$ref": "#/$defs/entity"}},
    "change_requests": {"type": "array", "items": {"$ref": "#/$defs/entity"}},
    "interactions": {"type": "array", "items": {"$ref": "#/$defs/entity"}},
    "commits": {"type": "array", "items": {"$ref": "#/$defs/entity"}},
    "ref_changes": {"type": "array", "items": {"$ref": "#/$defs/ref_change"}},
    "releases": {"type": "array", "items": {"$ref": "#/$defs/entity"}},
    "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
    "facts": {"type": "array", "items": {"$ref": "#/$defs/fact"}},
    "collection": {"$ref": "#/$defs/collection"},
    "privacy": {"$ref": "#/$defs/privacy"},
    "coverage": {"$ref": "#/$defs/coverage"}
  },
  "$defs": {
    "entity": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "occurred_at": {"type": "string", "format": "date-time"},
        "provider_id": {"type": "string", "minLength": 1},
        "repository_id": {"type": "string", "minLength": 1},
        "actor_id": {"type": "string", "minLength": 1},
        "sha": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "run": {
      "type": "object",
      "required": ["run_id", "window", "scope"],
      "properties": {
        "run_id": {"type": "string", "minLength": 1},
        "window": {
          "type": "object",
          "required": ["start", "end", "timezone"],
          "properties": {
            "start": {"type": "string", "format": "date-time"},
            "end": {"type": "string", "format": "date-time"},
            "timezone": {"type": "string", "minLength": 1}
          },
          "additionalProperties": true
        },
        "scope": {
          "type": "object",
          "required": ["repositories"],
          "properties": {
            "repositories": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
            "actors": {"type": "array", "items": {"type": "string", "minLength": 1}}
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "evidence": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "provider_id": {"type": "string", "minLength": 1},
        "subject_type": {"type": "string", "minLength": 1},
        "subject_id": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1},
        "url": {"type": "string", "format": "uri"},
        "source_ref": {"type": "string", "minLength": 1}
      },
      "anyOf": [{"required": ["url"]}, {"required": ["source_ref"]}],
      "additionalProperties": true
    },
    "fact": {
      "type": "object",
      "required": ["id", "evidence_ids"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "repository_id": {"type": "string", "minLength": 1},
        "actor_id": {"type": "string", "minLength": 1},
        "subject_type": {"type": "string", "minLength": 1},
        "subject_id": {"type": "string", "minLength": 1},
        "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "occurred_at": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": true
    },
    "ref_change": {
      "allOf": [
        {"$ref": "#/$defs/entity"},
        {
          "type": "object",
          "required": ["change_association"],
          "properties": {
            "change_association": {"enum": ["linked", "unlinked", "ambiguous", "unknown"]}
          }
        }
      ]
    },
    "coverage_diagnostics": {
      "type": "object",
      "properties": {
        "failure_class": {
          "enum": [
            "permission_denied",
            "rate_limited",
            "service_error",
            "not_found",
            "request_rejected",
            "malformed_response",
            "network_error",
            "transport_error",
            "fixture_missing",
            "http_error",
            "provider_not_ready",
            "unexpected_error",
            "unexpected_normalizer_error",
            "budget_exhausted",
            "insecure_transport",
            "privacy_violation"
          ]
        },
        "failure_classes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "permission_denied",
              "rate_limited",
              "service_error",
              "not_found",
              "request_rejected",
              "malformed_response",
              "network_error",
              "transport_error",
            "fixture_missing",
            "http_error",
            "provider_not_ready",
            "unexpected_error",
            "unexpected_normalizer_error",
            "budget_exhausted",
            "insecure_transport",
            "privacy_violation"
            ]
          }
        },
        "status_code": {"type": "integer"},
        "attempts": {"type": "integer", "minimum": 1},
        "retryable": {"type": "boolean"},
        "retry_after_seconds": {"type": "number", "minimum": 0},
        "rate_limit": {
          "type": "object",
          "properties": {
            "x-ratelimit-limit": {"type": "string"},
            "x-ratelimit-remaining": {"type": "string"},
            "x-ratelimit-reset": {"type": "string"},
            "retry-after": {"type": "string"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": true
    },
    "coverage_warning": {
      "type": "object",
      "required": ["code", "source", "provider_id", "repository_id", "status"],
      "properties": {
        "code": {"const": "optional_coverage_warning"},
        "source": {"enum": ["activities", "ref_changes"]},
        "provider_id": {"type": "string", "minLength": 1},
        "repository_id": {"type": "string", "minLength": 1},
        "status": {"enum": ["unsupported", "unavailable", "incomplete"]},
        "message": {"type": "string", "minLength": 1},
        "failure_class": {
          "enum": [
            "permission_denied",
            "rate_limited",
            "service_error",
            "not_found",
            "request_rejected",
            "malformed_response",
            "network_error",
            "transport_error",
            "fixture_missing",
            "http_error",
            "provider_not_ready",
            "unexpected_error",
            "unexpected_normalizer_error",
            "budget_exhausted",
            "insecure_transport",
            "privacy_violation"
          ]
        },
        "failure_classes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "permission_denied",
              "rate_limited",
              "service_error",
              "not_found",
              "request_rejected",
              "malformed_response",
              "network_error",
              "transport_error",
              "fixture_missing",
              "http_error",
              "provider_not_ready",
              "unexpected_error",
              "unexpected_normalizer_error",
              "budget_exhausted",
              "insecure_transport",
              "privacy_violation"
            ]
          }
        }
      },
      "additionalProperties": true
    },
    "privacy": {
      "type": "object",
      "required": ["actor_display", "source_urls", "auth_redaction"],
      "properties": {
        "actor_display": {"const": "anonymous"},
        "source_urls": {"const": "sanitized"},
        "auth_redaction": {"const": true}
      },
      "additionalProperties": false
    },
    "collection": {
      "type": "object",
      "properties": {
        "provider": {"type": "string", "minLength": 1},
        "instance": {"type": "string", "minLength": 1},
        "group_status": {"enum": ["completed", "failed", "diagnostic_insecure_transport"]},
        "failure_class": {"type": "string", "minLength": 1},
        "groups": {"type": "array", "items": {"type": "object"}},
        "limits": {"type": "object"},
        "metrics": {
          "type": "object",
          "properties": {
            "request_count": {"type": "integer", "minimum": 0},
            "page_count": {"type": "integer", "minimum": 0},
            "retry_count": {"type": "integer", "minimum": 0},
            "budget_exhausted": {"type": "boolean"},
            "cache_hits": {"type": "integer", "minimum": 0},
            "cache_misses": {"type": "integer", "minimum": 0},
            "cache_enabled": {"type": "boolean"},
            "insecure_transport": {"type": "boolean"}
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "coverage": {
      "type": "object",
      "required": ["required_sources", "observations", "fatal", "warnings", "allow_publish"],
      "properties": {
        "required_sources": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "repositories",
              "work_items",
              "change_requests",
              "interactions",
              "commits",
              "releases",
              "activities",
              "ref_changes"
            ]
          }
        },
        "observations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["source", "provider_id", "repository_id", "status"],
            "properties": {
              "source": {"type": "string", "minLength": 1},
              "provider_id": {"type": "string", "minLength": 1},
              "repository_id": {"type": "string", "minLength": 1},
              "status": {"enum": ["supported", "unsupported", "unavailable", "incomplete"]},
              "diagnostics": {"$ref": "#/$defs/coverage_diagnostics"}
            },
            "additionalProperties": true
          }
        },
        "fatal": {"type": "array"},
        "warnings": {
          "type": "array",
          "items": {"$ref": "#/$defs/coverage_warning"}
        },
        "group_failures": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["provider", "instance", "repository", "source", "failure_class"],
            "properties": {
              "provider": {"type": "string", "minLength": 1},
              "instance": {"type": "string", "minLength": 1},
              "repository": {"type": "string", "minLength": 1},
              "source": {"type": "string", "minLength": 1},
              "failure_class": {
                "enum": [
                  "permission_denied",
                  "rate_limited",
                  "service_error",
                  "not_found",
                  "request_rejected",
                  "malformed_response",
                  "network_error",
                  "transport_error",
                  "fixture_missing",
                  "http_error",
                  "provider_not_ready",
                  "unexpected_error",
                  "unexpected_normalizer_error",
                  "budget_exhausted",
                  "insecure_transport",
                  "privacy_violation"
                ]
              }
            },
            "additionalProperties": true
          }
        },
        "allow_publish": {"type": "boolean"}
      },
      "additionalProperties": true
    }
  }
}
